# ==================== SMARTDORM BACKEND ENVIRONMENT ====================
PORT=3001
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=smart_dormitory_super_secret_key_2024
JWT_EXPIRES_IN=7d

# MQTT Broker (HiveMQ High-Speed & High-Reliability Broker)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
# Khi có Mosquitto local: mqtt://localhost:1883

# Telegram Bot (Emergency & Alert Notification)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# InfluxDB (Docker - Optional time-series)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=smart-dormitory-super-secret-token-12345
INFLUXDB_ORG=smart-dormitory
INFLUXDB_BUCKET=smart-dormitory-raw

# ML Service (Python FastAPI — Local Port 8000)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# Gemini AI (Phase 3 — LLM Explanations & Assistant)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini
