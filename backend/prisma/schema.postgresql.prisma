// ========================================================================
// SMARTDORM HYBRID ARCHITECTURE — RELATIONAL DATABASE SCHEMA (POSTGRESQL)
// Synchronized 100% with schema.prisma for production PostgreSQL switch
// ========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: "ADMIN" | "STUDENT"
// DeviceType: "LIGHT" | "FAN" | "DOOR_LOCK" | "BUZZER" | "AIR_CON"
// EmergencyType: "FIRE" | "GAS_LEAK" | "INTRUSION" | "POWER_OUTAGE"
// EmergencyLevel: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"

model User {
  id           String   @id @default(cuid())
  studentId    String   @unique
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  rfidCardId   String?  @unique
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  accessLogs  AccessLog[]
  commandLogs CommandLog[]

  @@map("users")
}

model Building {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  floors    Int      @default(5)
  createdAt DateTime @default(now())

  rooms Room[]

  @@map("buildings")
}

model Room {
  id          String   @id @default(cuid())
  roomNumber  String
  floor       Int
  capacity    Int      @default(4)
  espDeviceId String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  users       User[]
  devices     Device[]
  sensorData  SensorData[]
  accessLogs  AccessLog[]
  emergencies Emergency[]

  @@unique([buildingId, roomNumber])
  @@map("rooms")
}

model Device {
  id        String   @id @default(cuid())
  name      String
  type      String   // LIGHT | FAN | DOOR_LOCK | BUZZER | AIR_CON
  isOn      Boolean  @default(false)
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  commandLogs CommandLog[]

  @@map("devices")
}

model SensorData {
  id             String   @id @default(cuid())
  temperature    Float?
  humidity       Float?
  gasLevel       Float?
  gasAlert       Boolean  @default(false)
  tempAlert      Boolean  @default(false)
  motionDetected Boolean  @default(false)
  recordedAt     DateTime @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  @@index([roomId, recordedAt])
  @@map("sensor_data")
}

model AccessLog {
  id         String   @id @default(cuid())
  rfidCardId String
  action     String
  authorized Boolean  @default(true)
  timestamp  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  @@index([roomId, timestamp])
  @@map("access_logs")
}

model CommandLog {
  id          String   @id @default(cuid())
  commandType String
  payload     String   // JSON string
  status      String   @default("pending")
  executedAt  DateTime @default(now())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("command_logs")
}

model Emergency {
  id          String    @id @default(cuid())
  type        String    // FIRE | GAS_LEAK | INTRUSION | POWER_OUTAGE
  level       String    // LOW | MEDIUM | HIGH | CRITICAL
  description String?
  sensorValue Float?
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@index([isResolved, level])
  @@map("emergencies")
}

// ==================== AI / MACHINE LEARNING ====================

model MlModel {
  id           String    @id @default(cuid())
  modelName    String
  modelType    String    // "FORECAST" | "ANOMALY" | "OCCUPANCY"
  version      String    @default("v1")
  status       String    @default("EXPERIMENTAL")
  trainedAt    DateTime  @default(now())
  datasetStart DateTime?
  datasetEnd   DateTime?
  metrics      String?
  artifactPath String?
  inferenceMs  Int?
  notes        String?
  createdAt    DateTime  @default(now())

  predictions MlPrediction[]

  @@map("ml_models")
}

model MlPrediction {
  id             String   @id @default(cuid())
  modelId        String
  model          MlModel  @relation(fields: [modelId], references: [id])
  roomId         String?
  buildingId     String?
  predictionType String
  inputData      String
  outputData     String
  confidence     Float?
  dataSource     String   @default("SIMULATION_DATA")
  createdAt      DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([predictionType, createdAt])
  @@map("ml_predictions")
}

model DeviceAnomaly {
  id             String    @id @default(cuid())
  deviceId       String?
  deviceName     String
  roomId         String
  anomalyScore   Float
  severity       String    @default("WARNING")
  features       String
  status         String    @default("OPEN")
  recommendation String?
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([roomId, detectedAt])
  @@index([status, severity])
  @@map("device_anomalies")
}

model OccupancyPrediction {
  id                  String   @id @default(cuid())
  roomId              String
  occupiedProbability Float
  predictedState      String
  features            String
  source              String   @default("RULE_PROXY")
  createdAt           DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("occupancy_predictions")
}

model AiRecommendation {
  id              String    @id @default(cuid())
  type            String
  severity        String    @default("WARNING")
  title           String
  description     String
  location        String?
  reason          String
  recommendation  String
  confidence      Float?
  evidence        String?
  status          String    @default("PENDING")
  acceptedBy      String?
  acceptedAt      DateTime?
  dismissedAt     DateTime?
  executedAt      DateTime?
  executionResult String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
  @@index([type, status])
  @@map("ai_recommendations")
}

model AutomationRule {
  id              String    @id @default(cuid())
  name            String
  description     String?
  conditions      String
  actions         String
  priority        Int       @default(50)
  enabled         Boolean   @default(false)
  cooldownMs      Int       @default(300000)
  lastTriggeredAt DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  executions AutomationExecution[]

  @@map("automation_rules")
}

model AutomationExecution {
  id              String         @id @default(cuid())
  ruleId          String
  rule            AutomationRule @relation(fields: [ruleId], references: [id])
  triggeredBy     String
  inputContext    String
  actionsExecuted String
  result          String
  requestedBy     String?
  executedAt      DateTime       @default(now())

  @@index([ruleId, executedAt])
  @@map("automation_executions")
}

model SystemSetting {
  id                     String   @id @default("default")
  tempWarning            Float    @default(38.0)
  tempCritical           Float    @default(48.0)
  gasWarning             Float    @default(35.0)
  gasCritical            Float    @default(60.0)
  powerWarningW          Float    @default(2500)
  autoLockSec            Int      @default(5)
  mqttBroker             String   @default("mqtt://broker.hivemq.com:1883")
  telegramBotToken       String   @default("")
  telegramChatId         String   @default("")
  smtpHost               String   @default("smtp.gmail.com")
  smtpPort               Int      @default(587)
  smtpUser               String   @default("")
  autoMonthlyBillEnabled Boolean  @default(true)
  dormElectricityRateVnd Float    @default(2260)
  updatedAt              DateTime @updatedAt

  @@map("system_settings")
}
