# ============================================================
# SmartDorm — Docker Compose Environment Variables
# ============================================================
# SAO CHÉP file này thành .env.docker và điền giá trị thật
# KHÔNG BAO GIỜ commit file .env.docker lên git
# ============================================================

# PostgreSQL
POSTGRES_USER=smartdorm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smartdorm_db

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# InfluxDB
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=CHANGE_ME_INFLUX_PASSWORD
INFLUXDB_INIT_ORG=smart-dormitory
INFLUXDB_INIT_BUCKET=smart-dormitory-raw
INFLUXDB_INIT_RETENTION=30d
INFLUXDB_INIT_TOKEN=CHANGE_ME_INFLUXDB_TOKEN

# SMTP Email (để trống nếu không dùng email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram (để trống nếu không dùng Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI (để trống nếu không dùng Copilot)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini
