# ==================== SMARTDORM ML SERVICE ENVIRONMENT ====================
# Host and Port
ML_HOST=0.0.0.0
ML_PORT=8000
LOG_LEVEL=INFO

# InfluxDB 2.7 Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=smart-dormitory-super-secret-token-12345
INFLUXDB_ORG=smart-dormitory
INFLUXDB_BUCKET=smart-dormitory-raw

# SQLite Fallback / Relational Database
DATABASE_URL=sqlite:///../backend/prisma/dev.db

# Model Artifacts Directory
MODEL_DIR=models

# Default Telemetry Data Source Tag
DATA_SOURCE_DEFAULT=SIMULATION_DATA

# CORS allowed origins (comma-separated or *)
CORS_ORIGINS=*
